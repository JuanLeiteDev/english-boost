# Copy to .env (git-ignored) and adjust. All optional.
# Linux only: your user/group ids (run: id -u ; id -g) so files created by the app stay yours.
# (Not called UID/GID because UID is a read-only variable in bash.)
EB_UID=1000
EB_GID=1000
# Port on this computer: http://127.0.0.1:8765
HOST_PORT=8765
# Time zone (decides "today" in the plan)
TZ=Europe/Lisbon
# Identity for commits made by the "Guardar no Git" button
GIT_USER_NAME=Juan Leite
GIT_USER_EMAIL=
